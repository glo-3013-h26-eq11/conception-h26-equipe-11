[Unit]
Description=Rover Initialization
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=norlab
WorkingDirectory=/home/norlab/repos/conception-h26-equipe-11
Environment="ROS_DOMAIN_ID=11"
ExecStart=/home/norlab/repos/conception-h26-equipe-11/scripts/run_rover_docker2.sh
RemainAfterExit=yes

StandardOutput=journal
StandardError=journal

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target